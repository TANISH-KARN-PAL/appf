int fact(int n){
    int a=1;
    for(int i=1;i<=n;i++){
       a*=i; 
    }
    return a;
}
bool isPrime(int n){
    int ct=0;
    for(int i=1;i<n;i++){
        if(n%i==0)
        ct++;
    }
    if(ct==1)
    return true;
    else 
    return false;
}
bool isStrong(int n){
    int a=n,sm=0;
    while(a>0){
        sm+=fact(a%10);
        a/=10;
    }
    if(n==sm)
    return true;
    else 
    return false;
}
